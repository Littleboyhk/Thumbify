# ==========================================
# Telegram Thumbnail Changer Bot Configuration
# ==========================================

# Obtain API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Obtain BOT_TOKEN from https://t.me/BotFather
BOT_TOKEN=123456789:ABCDefGhIJklMNopQRstUVwxyz

# Your Telegram User ID (obtain from @userinfobot or @MissRose_bot)
BOT_OWNER=123456789

# Authorized User IDs separated by commas (optional: leave empty to allow everyone)
AUTH_USERS=123456789,987654321

# Optional Telegram Premium Session String for files > 2GB (up to 4GB support)
# Leave empty if you only work with files <= 2GB.
STRING_SESSION=

